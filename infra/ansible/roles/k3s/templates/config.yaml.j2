write-kubeconfig-mode: "0600"
token: {{ k3s_token | to_json }}
node-ip: {{ ansible_host | to_json }}
advertise-address: {{ ansible_host | to_json }}
tls-san:
  - {{ homelab_spec.network.controlPlaneVip | to_json }}
flannel-backend: none
disable-kube-proxy: true
disable-network-policy: true
secrets-encryption: true
protect-kernel-defaults: true
disable:
  - local-storage
  - metrics-server
  - servicelb
  - traefik
kube-apiserver-arg:
  - audit-log-maxage=30
  - audit-log-maxbackup=10
  - audit-log-maxsize=100
  - audit-log-path=/var/lib/rancher/k3s/server/logs/audit.log
  - audit-policy-file=/etc/rancher/k3s/audit-policy.yaml
kubelet-arg:
  - read-only-port=0
etcd-snapshot-schedule-cron: "0 */6 * * *"
etcd-snapshot-retention: 28
etcd-s3: true
etcd-s3-endpoint: {{ homelab_spec.storage.s3.endpoint | regex_replace('^https?://', '') | to_json }}
etcd-s3-insecure: {{ homelab_spec.storage.s3.endpoint is match('^http://') | to_json }}
etcd-s3-bucket: {{ homelab_spec.storage.s3.bucket | to_json }}
etcd-s3-folder: k3s-etcd
etcd-s3-access-key: {{ k3s_s3_access_key | to_json }}
etcd-s3-secret-key: {{ k3s_s3_secret_key | to_json }}
etcd-s3-timeout: 5m
{% if inventory_hostname in groups['initial_server'] %}
cluster-init: true
{% else %}
server: {{ ('https://' ~ homelab_spec.network.controlPlaneVip ~ ':6443') | to_json }}
{% endif %}
