{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Africa/Casablanca",
  "schedule": [
    "before 06:00 on Monday"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "automerge": false,
  "enabledManagers": [
    "ansible-galaxy",
    "dockerfile",
    "gitlabci",
    "gomod",
    "helm-values",
    "helmv3",
    "kubernetes",
    "npm",
    "regex",
    "terraform"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "KUBECONFORM_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "yannh/kubeconform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "KUBE_LINTER_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "stackrox/kube-linter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "GITLEAKS_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "KYVERNO_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "kyverno/kyverno",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "KUSTOMIZE_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^kustomize/(?<version>v.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "HELM_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "AGE_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "FiloSottile/age",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "YQ_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "SOPS_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "TOFU_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "PROMETHEUS_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "prometheus/prometheus",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "MARKDOWNLINT_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "markdownlint-cli2",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "SHELLCHECK_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/argocd/dependencies\\.env$/"
      ],
      "matchStrings": [
        "ARGOCD_CHART_VERSION=(?<currentValue>[^\\s]+)\\nARGOCD_CHART_REF=oci://(?<depName>ghcr\\.io/argoproj/argo-helm/argo-cd)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/argocd/dependencies\\.env$/"
      ],
      "matchStrings": [
        "ARGOCD_IMAGE=(?<depName>quay\\.io/argoproj/argocd):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/argocd/dependencies\\.env$/"
      ],
      "matchStrings": [
        "KSOPS_IMAGE=(?<depName>docker\\.io/viaductoss/ksops):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/argocd/dependencies\\.env$/"
      ],
      "matchStrings": [
        "YQ_IMAGE=(?<depName>docker\\.io/mikefarah/yq):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/cilium/dependencies\\.env$/"
      ],
      "matchStrings": [
        "CILIUM_VERSION=(?<currentValue>[^\\s]+)\\nCILIUM_CHART_REF=oci://(?<depName>quay\\.io/cilium/charts/cilium)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/cilium/dependencies\\.env$/"
      ],
      "matchStrings": [
        "GATEWAY_API_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/cert-manager/dependencies\\.env$/"
      ],
      "matchStrings": [
        "CERT_MANAGER_CHART_VERSION=(?<currentValue>[^\\s]+)\\nCERT_MANAGER_CHART_REF=oci://(?<depName>quay\\.io/jetstack/charts/cert-manager)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/external-dns/dependencies\\.env$/"
      ],
      "matchStrings": [
        "EXTERNAL_DNS_CHART_VERSION=(?<currentValue>[^\\s]+)\\nEXTERNAL_DNS_APP_VERSION=(?<appVersion>[^\\s]+)\\nEXTERNAL_DNS_CHART_URL=https://github\\.com/kubernetes-sigs/external-dns/releases/download/helm-chart-[^/]+/external-dns-[^\\s]+\\.tgz"
      ],
      "depNameTemplate": "kubernetes-sigs/external-dns",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^helm-chart-(?<version>.*)$",
      "autoReplaceStringTemplate": "EXTERNAL_DNS_CHART_VERSION={{{newValue}}}\\nEXTERNAL_DNS_APP_VERSION={{{appVersion}}}\\nEXTERNAL_DNS_CHART_URL=https://github.com/kubernetes-sigs/external-dns/releases/download/helm-chart-{{{newValue}}}/external-dns-{{{newValue}}}.tgz"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^platform/cloudflared/dependencies\\.env$/"
      ],
      "matchStrings": [
        "CLOUDFLARED_VERSION=(?<currentValue>[^\\s]+)\\nCLOUDFLARED_IMAGE=(?<depName>docker\\.io/cloudflare/cloudflared):[^@\\s]+@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Never automerge infrastructure dependencies",
      "matchManagers": [
        "ansible-galaxy",
        "gitlabci",
        "helmv3",
        "kubernetes",
        "terraform"
      ],
      "automerge": false
    }
  ]
}
