{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Africa/Casablanca",
  "schedule": [
    "before 06:00 on Monday"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "automerge": false,
  "enabledManagers": [
    "ansible-galaxy",
    "dockerfile",
    "gitlabci",
    "gomod",
    "helm-values",
    "helmv3",
    "kubernetes",
    "npm",
    "regex",
    "terraform"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "KUBECONFORM_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "yannh/kubeconform",
      "datasourceTemplate": "github-releases"
    },
