{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchDatasources": ["helm"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["ansible", "galaxy"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["gitlab-ci"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchDatasources": ["terraform", "tofu"],
      "automerge": true,
      "automergeType": "branch"
    }
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "schedule": ["before 5am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "major": {
    "automerge": false
  },
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  }
}