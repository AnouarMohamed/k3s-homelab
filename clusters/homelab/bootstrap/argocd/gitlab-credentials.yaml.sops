apiVersion: v1
kind: Secret
metadata:
  name: gitlab-credentials
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  # URL of the GitLab repository
  url: https://gitlab.com/your-username/your-repo.git
  # GitLab personal access token or deploy token with read-only access
  # This should be encrypted with SOPS before committing
  password: !encrypted
    age: age1placeholderxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  # Username for GitLab (can be empty for token-based auth)
  username: gitlab-token